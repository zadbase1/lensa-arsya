# 1. DATABASE (Vercel Postgres / Neon)
# Otomatis terisi saat Anda menghubungkan Vercel Postgres di Vercel Dashboard.
# Format: postgres://[user]:[password]@[host]/[dbname]?sslmode=require
POSTGRES_URL="postgres://default:xxx@ep-xxx-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
POSTGRES_PRISMA_URL="postgres://default:xxx@ep-xxx-pooler.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgres://default:xxx@ep-xxx.us-east-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"

# 2. NEXTAUTH.JS AUTHENTICATION
# Secret key untuk mengenkripsi JWT Session token.
# Di production, buat string acak aman (misal via `openssl rand -base64 32`)
NEXTAUTH_SECRET="lensa-arsya-super-secure-production-secret-2026"

# Di production diisi URL subdomain admin, misal: https://admin.lensaarsya.com
# Di local development: http://admin.localhost:3000
NEXTAUTH_URL="http://admin.localhost:3000"

